<!DOCTYPE html>
<html data-bs-theme="light" lang="en-US" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>EraaSoftAcademy | Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --falcon-primary: #2c7be5;
            --falcon-secondary: #748194;
            --falcon-success: #00d27a;
            --falcon-info: #27bcfd;
            --falcon-warning: #f5803e;
            --falcon-danger: #e63757;
            --falcon-light: #f9fafd;
            --falcon-dark: #0b1727;
            --navbar-vertical-width: 12.625rem;
            --navbar-vertical-bg: #fff;
            --card-bg: #fff;
            --body-bg: #edf2f9;
            --text-primary: #344050;
            --text-secondary: #748194;
            --text-muted: #9da9bb;
            --border-color: #d8e2ef;
            --card-shadow: 0 7px 14px rgba(52,78,113,.1), 0 3px 6px rgba(52,78,113,.08);
            --sidebar-link-hover: #f9fafd;
            --sidebar-link-active-bg: #f0f4ff;
            --sidebar-link-active-color: var(--falcon-primary);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            background: var(--body-bg);
            color: var(--text-primary);
            font-size: 0.875rem;
            margin: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand span {
            font-family: 'Poppins', sans-serif;
        }

        /* ── Sidebar ── */
        .navbar-vertical {
            width: var(--navbar-vertical-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: var(--navbar-vertical-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            overflow: hidden;
        }

        .navbar-brand-wrapper {
            padding: 0 1rem;
            height: 4.3125rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

            .navbar-brand-wrapper .brand-text {
                font-family: 'Poppins', sans-serif;
                font-weight: 700;
                font-size: 1.1rem;
                color: var(--falcon-primary);
                letter-spacing: -0.3px;
            }

        .navbar-vertical-content {
            flex: 1;
            overflow-y: auto;
            padding: 1rem 0;
        }

            .navbar-vertical-content::-webkit-scrollbar {
                width: 4px;
            }

            .navbar-vertical-content::-webkit-scrollbar-thumb {
                background: var(--border-color);
                border-radius: 4px;
            }

        .nav-section-label {
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 0.75rem 1rem 0.35rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0.53rem 1rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.8125rem;
            font-weight: 500;
            border-radius: 0;
            transition: color 0.15s, background 0.15s;
            position: relative;
        }

            .sidebar-link:hover {
                background: var(--sidebar-link-hover);
                color: var(--text-primary);
            }

            .sidebar-link.active {
                color: var(--falcon-primary);
                background: var(--sidebar-link-active-bg);
                font-weight: 600;
            }

                .sidebar-link.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 3px;
                    background: var(--falcon-primary);
                    border-radius: 0 2px 2px 0;
                }

            .sidebar-link i {
                width: 1.125rem;
                font-size: 0.8125rem;
                text-align: center;
                flex-shrink: 0;
            }

            .sidebar-link .badge {
                margin-left: auto;
                font-size: 0.6rem;
                padding: 0.2em 0.5em;
            }

        .sidebar-divider {
            border-top: 1px solid var(--border-color);
            margin: 0.75rem 1rem;
        }

        /* ── Content ── */
        .content-wrapper {
            margin-left: var(--navbar-vertical-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Top Navbar ── */
        .navbar-top {
            height: 4.3125rem;
            background: rgba(255,255,255,0.96);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            gap: 1rem;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .search-box-top {
            position: relative;
            flex: 0 0 260px;
        }

            .search-box-top input {
                width: 100%;
                height: 2.125rem;
                background: var(--body-bg);
                border: 1px solid var(--border-color);
                border-radius: 1.375rem;
                padding: 0 1rem 0 2.25rem;
                font-size: 0.8125rem;
                color: var(--text-primary);
                outline: none;
                transition: border-color 0.15s, box-shadow 0.15s;
            }

                .search-box-top input:focus {
                    border-color: var(--falcon-primary);
                    box-shadow: 0 0 0 3px rgba(44,123,229,.15);
                }

                .search-box-top input::placeholder {
                    color: var(--text-muted);
                }

            .search-box-top i {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 0.75rem;
            }

        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .topbar-icon-btn {
            width: 2.125rem;
            height: 2.125rem;
            border: none;
            background: transparent;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.875rem;
            position: relative;
            transition: background 0.15s, color 0.15s;
        }

            .topbar-icon-btn:hover {
                background: var(--body-bg);
                color: var(--falcon-primary);
            }

            .topbar-icon-btn .notif-dot {
                position: absolute;
                top: 4px;
                right: 4px;
                width: 8px;
                height: 8px;
                background: var(--falcon-danger);
                border-radius: 50%;
                border: 2px solid #fff;
            }

        .topbar-avatar {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid var(--border-color);
            transition: border-color 0.15s;
        }

            .topbar-avatar:hover {
                border-color: var(--falcon-primary);
            }

        /* ── Page ── */
        .page-content {
            padding: 1.5rem;
            flex: 1;
        }

        .page-header {
            margin-bottom: 1.5rem;
        }

            .page-header h4 {
                font-size: 1.125rem;
                font-weight: 700;
                color: var(--text-primary);
                margin: 0;
            }

            .page-header .breadcrumb {
                font-size: 0.8rem;
                margin: 0;
            }

        .breadcrumb-item a {
            color: var(--falcon-primary);
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: var(--text-muted);
        }

        /* ── Stat Cards ── */
        .stat-card {
            background: var(--card-bg);
            border-radius: 0.375rem;
            border: 1px solid var(--border-color);
            padding: 1.25rem;
            box-shadow: var(--card-shadow);
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(52,78,113,.12);
            }

        .stat-icon-wrap {
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

            .stat-icon-wrap.blue {
                background: rgba(44,123,229,.15);
                color: var(--falcon-primary);
            }

            .stat-icon-wrap.green {
                background: rgba(0,210,122,.15);
                color: var(--falcon-success);
            }

            .stat-icon-wrap.orange {
                background: rgba(245,128,62,.15);
                color: var(--falcon-warning);
            }

            .stat-icon-wrap.red {
                background: rgba(230,55,87,.15);
                color: var(--falcon-danger);
            }

            .stat-icon-wrap.teal {
                background: rgba(39,188,253,.15);
                color: var(--falcon-info);
            }

            .stat-icon-wrap.purple {
                background: rgba(108,99,255,.15);
                color: #6c63ff;
            }

        .stat-info {
            flex: 1;
            min-width: 0;
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .stat-value {
            font-family: 'Poppins', sans-serif;
            font-size: 1.375rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-change {
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 2px;
        }

            .stat-change.up {
                color: var(--falcon-success);
            }

            .stat-change.down {
                color: var(--falcon-danger);
            }

            .stat-change.neutral {
                color: var(--text-muted);
            }

        /* ── Card ── */
        .dash-card {
            background: var(--card-bg);
            border-radius: 0.375rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--card-shadow);
            overflow: hidden;
        }

        .dash-card-header {
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dash-card-title {
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
        }

        .dash-card-body {
            padding: 1.25rem;
        }

            .dash-card-body.p0 {
                padding: 0;
            }

        /* ── Chart containers ── */
        .chart-wrap {
            position: relative;
        }

        /* ── Table ── */
        .dash-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8125rem;
        }

            .dash-table thead th {
                padding: 0.625rem 1.25rem;
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--text-muted);
                background: var(--body-bg);
                border-bottom: 1px solid var(--border-color);
                white-space: nowrap;
            }

            .dash-table tbody td {
                padding: 0.75rem 1.25rem;
                border-bottom: 1px solid var(--border-color);
                color: var(--text-primary);
                vertical-align: middle;
            }

            .dash-table tbody tr:last-child td {
                border-bottom: none;
            }

            .dash-table tbody tr:hover {
                background: var(--body-bg);
            }

        /* ── Badges ── */
        .status-badge {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.25em 0.6em;
            border-radius: 2rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .badge-success {
            background: rgba(0,210,122,.15);
            color: #00864f;
        }

        .badge-warning {
            background: rgba(245,128,62,.15);
            color: #b85c1a;
        }

        .badge-danger {
            background: rgba(230,55,87,.15);
            color: #a31c39;
        }

        .badge-info {
            background: rgba(39,188,253,.15);
            color: #0b7eb3;
        }

        .badge-secondary {
            background: rgba(116,129,148,.15);
            color: #4a5568;
        }

        /* ── Avatar group ── */
        .avatar-sm {
            width: 1.875rem;
            height: 1.875rem;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #fff;
        }

        .user-cell {
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }

        .user-initials {
            width: 1.875rem;
            height: 1.875rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        /* ── Progress ── */
        .progress-thin {
            height: 4px;
            background: var(--body-bg);
            border-radius: 99px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 99px;
        }

        .fill-primary {
            background: var(--falcon-primary);
        }

        .fill-success {
            background: var(--falcon-success);
        }

        .fill-warning {
            background: var(--falcon-warning);
        }

        .fill-danger {
            background: var(--falcon-danger);
        }

        .fill-info {
            background: var(--falcon-info);
        }

        .fill-purple {
            background: #6c63ff;
        }

        /* ── Activity feed ── */
        .activity-item {
            display: flex;
            gap: 0.75rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--border-color);
        }

            .activity-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .activity-icon {
            width: 2rem;
            height: 2rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            flex-shrink: 0;
        }

        .activity-content {
            flex: 1;
            min-width: 0;
        }

        .activity-text {
            font-size: 0.8125rem;
            color: var(--text-primary);
            line-height: 1.4;
        }

            .activity-text strong {
                font-weight: 600;
            }

        .activity-time {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* ── Top courses ── */
        .course-rank-item {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--border-color);
        }

            .course-rank-item:last-child {
                border-bottom: none;
            }

        .course-rank-num {
            width: 1.5rem;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            text-align: center;
            flex-shrink: 0;
        }

        .course-thumb-sm {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.375rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .course-rank-info {
            flex: 1;
            min-width: 0;
        }

        .course-rank-name {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .course-rank-meta {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .course-rank-rev {
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--falcon-success);
            white-space: nowrap;
        }

        /* ── Summary mini cards ── */
        .mini-stat {
            text-align: center;
            padding: 1rem;
            border-right: 1px solid var(--border-color);
        }

            .mini-stat:last-child {
                border-right: none;
            }

        .mini-stat-val {
            font-family: 'Poppins', sans-serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .mini-stat-label {
            font-size: 0.7rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-top: 2px;
        }

        /* ── Button ── */
        .btn-falcon {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 0.25rem;
            border: 1px solid var(--border-color);
            background: #fff;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

            .btn-falcon:hover {
                background: var(--falcon-primary);
                color: #fff;
                border-color: var(--falcon-primary);
            }

        .btn-falcon-primary {
            background: var(--falcon-primary);
            color: #fff;
            border-color: var(--falcon-primary);
        }

            .btn-falcon-primary:hover {
                background: #1a68d1;
            }

        /* ── Dropdown dot menu ── */
        .dot-menu {
            background: none;
            border: none;
            padding: 4px 8px;
            cursor: pointer;
            color: var(--text-muted);
            border-radius: 4px;
        }

            .dot-menu:hover {
                background: var(--body-bg);
                color: var(--text-primary);
            }

        /* ── Responsive ── */
        @@media (max-width: 992px) {
            .navbar-vertical {
                transform: translateX(-100%);
            }

            .content-wrapper {
                margin-left: 0;
            }
        }

        @@keyframes fadeSlideUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .anim {
            animation: fadeSlideUp 0.4s ease both;
        }

        .anim-1 {
            animation-delay: 0.05s;
        }

        .anim-2 {
            animation-delay: 0.1s;
        }

        .anim-3 {
            animation-delay: 0.15s;
        }

        .anim-4 {
            animation-delay: 0.2s;
        }

        .anim-5 {
            animation-delay: 0.25s;
        }

        .anim-6 {
            animation-delay: 0.3s;
        }

        .anim-7 {
            animation-delay: 0.35s;
        }

        .anim-8 {
            animation-delay: 0.4s;
        }
    </style>


</head>
<body>

    <!-- ══════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════ -->
    <aside class="navbar-vertical">
        <div class="navbar-brand-wrapper">
            <a href="/Admin/Home" style="text-decoration:none; display:flex; align-items:center; gap:0.5rem;">
                <div style="width:32px;height:32px;background:var(--falcon-primary);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:800;font-family:Poppins,sans-serif;">E</div>
                <span class="brand-text">EraaSoft</span>
            </a>
        </div>

        <div class="navbar-vertical-content">

            
            <a href="/Admin/Course/Index" class="sidebar-link">
                <i class="fas fa-graduation-cap"></i> Courses
                <!-- <span class="badge bg-primary text-white ms-auto">12</span>-->
            </a>
            <a href="/Admin/Quiz/Index" class="sidebar-link">
                <i class="fas fa-pencil-alt"></i> Quizzes
            </a>
           

            
            <a href="/Admin/Payment/Index" class="sidebar-link">
                <i class="fas fa-credit-card"></i> Payments
            </a>
            

            

            
            <a href="/Admin/Instructor/Index" class="sidebar-link">
                <i class="fas fa-chalkboard-teacher"></i> Instructors
            </a>
            <a href="/Admin/Student/Index" class="sidebar-link">
                <i class="fas fa-user-graduate"></i> Students
            </a>

           

            
            <a href="/Identity/Account/Logout" class="sidebar-link" style="color:var(--falcon-danger);">
                <i class="fas fa-sign-out-alt"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ══════════════════════════════════════
         CONTENT
    ══════════════════════════════════════ -->
    <div class="content-wrapper">

        <!-- Top Navbar -->
        <nav class="navbar-top">
            <div class="search-box-top">
                <i class="fas fa-search"></i>
                <input type="search" placeholder="Search users, courses...">
            </div>

            <div class="topbar-right">
                <!-- Notifications -->
                <button class="topbar-icon-btn" title="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="notif-dot"></span>
                </button>
                <!-- Messages -->
                <button class="topbar-icon-btn" title="Messages">
                    <i class="fas fa-envelope"></i>
                </button>
                <!-- Settings -->
                <button class="topbar-icon-btn" title="Settings">
                    <i class="fas fa-cog"></i>
                </button>

                <div style="width:1px;height:24px;background:var(--border-color);margin:0 0.5rem;"></div>

                <!-- Avatar -->
                <div style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
                    <div style="width:2rem;height:2rem;border-radius:50%;background:linear-gradient(135deg,#2c7be5,#6c63ff);display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.7rem;font-weight:700;">AD</div>
                    <div style="display:none;" class="d-lg-block">
                        <div style="font-size:0.8rem;font-weight:600;color:var(--text-primary);line-height:1.1;">Admin</div>
                        <div style="font-size:0.7rem;color:var(--text-muted);">Super Admin</div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- PAGE CONTENT -->
        <div class="card-box">
            @RenderBody()
        </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <div class="card-box">
            @RenderBody()
        </div>

        @RenderSection("Scripts", required: false)

